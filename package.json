{
  "name": "@an1creator/zerosub",
  "version": "1.6.0",
  "description": "Manage Claude and Codex accounts with per-account proxies and English/Russian UI.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude",
    "claude-code",
    "codex",
    "chatgpt",
    "subscriptions",
    "accounts",
    "usage-limits"
  ],
  "homepage": "https://github.com/an1creator/zerosub#readme",
  "bugs": {
    "url": "https://github.com/an1creator/zerosub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/an1creator/zerosub.git"
  },
  "license": "MIT",
  "author": "Kapybara",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "!**/*.test.ts",
    "README.md",
    "LICENSE",
    "!**/*.test.tsx",
    "docs/",
    "scripts/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "audit:mobile": "! grep -rnE --exclude=language-source.ts \"\\\\b(document|window|localStorage|navigator)\\\\.|<(div|span|p|a|button|input|img|ul|ol|li|section|header|footer|main|nav|form|label|h[1-6]|table|tr|td|svg|path|br|hr)[ >/]|className=|onClick=\" client/"
  },
  "devDependencies": {
    "@getpaseo/client": "^0.12.0",
    "@getpaseo/plugin": "^0.12.0",
    "@getpaseo/protocol": "^0.12.0",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.20.4",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "https-proxy-agent": "^7.0.6",
    "socks": "^2.8.10",
    "socks-proxy-agent": "^8.0.5"
  }
}
